---
interface Props {
  href: string;
  title: string;
  language: string;
  languageIcon?: string;
  color?: string;
  subtitle?: string;
  type?: string;
  typeColor?: string;
}

const { href, title, language, languageIcon, color = '#86efac', subtitle, type, typeColor = '#86efac' } = Astro.props;
const iconUrl = languageIcon && (languageIcon.startsWith('/') || languageIcon.startsWith('http')
  ? languageIcon
  : `https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${languageIcon}/${languageIcon}-original.svg`);
---

<a class="project-card" href={href}>
  {iconUrl && <img class="project-card-icon" src={iconUrl} alt="" width="28" height="28" />}
  <div class="project-card-text">
    <strong class="project-card-title">{title}</strong>
    {subtitle && <span class="project-card-subtitle">{subtitle}</span>}
  </div>
  <span class="project-card-badge" style={`--badge-color: ${color}`}>{language}</span>
  {type && <span class="project-card-badge" style={`--badge-color: ${typeColor}`}>{type}</span>}
</a>

<style>
  .project-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 8px;
    background: var(--sl-color-bg-nav);
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: var(--sl-color-accent);
  }

  .project-card-icon {
    flex-shrink: 0;
    margin: 0 !important;
  }

  .project-card-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .project-card-subtitle {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }

  .project-card-title {
    font-size: 1.15rem;
    color: var(--sl-color-white);
  }

  .project-card-badge {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--badge-color);
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--badge-color) 20%, transparent);
    color: var(--badge-color);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.4;
  }
</style>
