---
interface Props { lang: 'pt-br' | 'en-us' }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = lang === 'pt-br'
  ? {
      docs: 'Documentações', docsSub: 'Se você acessar as documentações, sua vida nunca mais vai ser a mesma',
      profile: 'Meu perfil', profileSub: 'Se você acessar meu perfil, vai continuar no país das maravilhas',
      back: 'Voltar',
    }
  : {
      docs: 'Documentation', docsSub: 'If you access the documentation, your life will never be the same',
      profile: 'My profile', profileSub: 'If you access my profile, you will stay in Wonderland',
      back: 'Back',
    };
---

<!doctype html>
<html lang={lang === 'pt-br' ? 'pt-BR' : 'en-US'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FantoDocs</title>
    <link rel="icon" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <canvas id="rain" aria-hidden="true"></canvas>
    <main>
      <svg class="logo" viewBox="0 0 24 24" fill="none" stroke="#1ee82c" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-label="FantoDocs">
        <path d="M5 7l5 5l-5 5" /><path class="cursor" d="M12 19l7 0" />
      </svg>
      <div class="choices">
        <a class="choice red" href={`${base}/${lang}/initial-page/`}>
          <span class="label">{t.docs}</span>
          <span class="sub">{t.docsSub}</span>
        </a>
        <a class="choice blue" href={`${base}/${lang}/profile/`}>
          <span class="label">{t.profile}</span>
          <span class="sub">{t.profileSub}</span>
        </a>
      </div>
      <a class="back" href={`${base}/${lang}/`}>← {t.back}</a>
    </main>
  </body>
</html>

<style is:global>
  html, body { margin: 0; height: 100%; background: #07090a; color: #e6edf3; font-family: 'JetBrains Mono', 'JetBrainsMonoNerd', monospace; overflow: hidden; }
  #rain { position: fixed; inset: 0; width: 100%; height: 100%; opacity: 0.22; z-index: 0; }
  main { position: relative; z-index: 1; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3rem; padding: 1rem; box-sizing: border-box; }
  .logo { width: min(260px, 50vw); filter: drop-shadow(0 0 12px rgba(30, 232, 44, 0.5)); }
  .cursor { animation: blink 1.2s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .choices { display: flex; gap: 2rem; flex-wrap: wrap; justify-content: center; }
  .choice { --c: #fff; display: flex; flex-direction: column; align-items: center; gap: 0.7rem; width: 280px; padding: 1.1rem 1.2rem; text-align: center; text-decoration: none; color: var(--c); background: rgba(7, 9, 10, 0.85); border: 2px solid var(--c); border-radius: 14px; box-shadow: 0 0 10px color-mix(in srgb, var(--c) 45%, transparent); animation: pulse 2.4s ease-in-out infinite; transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease; }
  .choice.red { --c: #ff3b3b; }
  .choice.blue { --c: #3b82f6; animation-delay: 1.2s; }
  .label { font-size: 1.3rem; font-weight: 700; letter-spacing: 0.05em; }
  .sub { font-size: 0.8rem; color: #9aa4ad; line-height: 1.4; }
  .choice:hover { transform: translateY(-6px) scale(1.05); background: color-mix(in srgb, var(--c) 14%, #07090a); box-shadow: 0 0 28px var(--c); animation-play-state: paused; }
  @keyframes pulse { 0%, 100% { box-shadow: 0 0 8px color-mix(in srgb, var(--c) 35%, transparent); } 50% { box-shadow: 0 0 22px color-mix(in srgb, var(--c) 80%, transparent); } }
  .back { position: absolute; top: 1rem; left: 1.2rem; color: #6e7681; text-decoration: none; font-size: 0.9rem; }
  .back:hover { color: #4ade80; }
  @media (prefers-reduced-motion: reduce) { .choice, .cursor { animation: none; } }
</style>

<script>
  const canvas = document.getElementById('rain') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const chars = 'ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789'.split('');
  const size = 16;
  let drops: number[] = [];
  const resize = () => {
    canvas.width = innerWidth;
    canvas.height = innerHeight;
    drops = Array.from({ length: Math.ceil(canvas.width / size) }, () => Math.random() * -50);
  };
  resize();
  addEventListener('resize', resize);
  setInterval(() => {
    ctx.fillStyle = 'rgba(7, 9, 10, 0.08)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = '#1ee82c';
    ctx.font = `${size}px monospace`;
    drops.forEach((y, i) => {
      ctx.fillText(chars[Math.floor(Math.random() * chars.length)], i * size, y * size);
      drops[i] = y * size > canvas.height && Math.random() > 0.975 ? 0 : y + 1;
    });
  }, 60);
</script>
